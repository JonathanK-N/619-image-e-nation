# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Admin
ADMIN_PASSWORD=your_secure_password

# App
BASE_URL=https://your-domain.railway.app
PORT=3000

# ─── Photo storage ───
# Option A — Cloudinary (recommandé en production : durable + CDN).
# Copiez l'"API Environment variable" de votre dashboard Cloudinary :
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# (ou séparément)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=image-e-nation

# Option B — Volume Railway persistant (données JSON + uploads locaux).
# Montez un volume (ex: /data) puis pointez-y ces dossiers :
# DATA_DIR=/data/store
# UPLOADS_DIR=/data/uploads
